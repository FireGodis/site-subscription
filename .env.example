# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated administrator email allowlist (never expose this in NEXT_PUBLIC vars)
ADMIN_EMAILS=

# Mercado Pago → Your integrations → Credentials → Production or Test access token
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks → Secret signature key
MERCADOPAGO_WEBHOOK_SECRET=

# Public HTTPS deployment origin, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
